#!/usr/bin/env bash

# Wrapper script for headless rendering
# Usage: ./render -d 2026-06-20 [-l 1] [-g 300] [-m full] [-o custom_output.mp4]

# Set defaults
MODE="full"
DIVE_LIST=""
GAP="1800" # Default gap to 5 mins based on our findings
DATE=""
OUTPUT=""

# Ensure uv is installed
if ! command -v uv >/dev/null 2>&1; then
    echo "Error: 'uv' is not installed."
    echo "Please install it using: curl -LsSf https://astral.sh/uv/install.sh | sh"
    echo "Or on macOS: brew install uv"
    exit 1
fi

# Load configuration from .env
if [ -f ".env" ]; then
    source .env
else
    echo "Error: .env file not found. Please copy .env.example to .env and adjust."
    exit 1
fi

if [ -z "$SEARCH_DIR" ] || [ -z "$LOGS_DIR" ]; then
    echo "Error: SEARCH_DIR or LOGS_DIR not set in .env."
    exit 1
fi

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -d|--date) DATE="$2"; shift ;;
        -m|--mode) MODE="$2"; shift ;;
        -l|--dive_list) DIVE_LIST="$2"; shift ;;
        -g|--gap) GAP="$2"; shift ;;
        -o|--output) OUTPUT="$2"; shift ;;
        *) echo "Unknown parameter passed: $1"; exit 1 ;;
    esac
    shift
done

if [ -z "$DATE" ]; then
    echo "Usage: ./render -d YYYY-MM-DD"
    exit 1
fi

if [ -z "$OUTPUT" ]; then
    OUTPUT="$HOME/Movies/dive_${DATE}"
    if [ -n "$DIVE_LIST" ]; then
        OUTPUT="${OUTPUT}_dive${DIVE_LIST}"
    fi
    if [ "$MODE" = "highlights" ]; then
        OUTPUT="${OUTPUT}_highlights"
    fi
    OUTPUT="${OUTPUT}.mp4"
fi

CMD=(
    "uv" "run" "scripts/build_headless_movie.py"
    "--date" "$DATE"
    "--logs_dir" "$LOGS_DIR"
    "--media_dir" "$SEARCH_DIR"
    "--output" "$OUTPUT"
    "--mode" "$MODE"
    "--gap" "$GAP"
)

if [ -n "$DIVE_LIST" ]; then
    CMD+=("--dive_list" "$DIVE_LIST")
fi

echo "🎬 Starting headless render..."
echo "📅 Date: $DATE"
echo "🌊 Dives: ${DIVE_LIST:-All}"
echo "📁 Output: $OUTPUT"
echo "----------------------------------------"

"${CMD[@]}"
